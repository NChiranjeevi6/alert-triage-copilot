# Only needed for --mode live. Never commit real keys.
# The tool reads these from ENVIRONMENT VARIABLES, it does not load a .env file by itself.
# Load them into your shell first:
#   Mac/Linux:   set -a; source .env; set +a
#   PowerShell:  $env:VT_API_KEY="your_virustotal_key"
VT_API_KEY=your_virustotal_key
ABUSEIPDB_API_KEY=your_abuseipdb_key
